# Provider: "openai" (needs OPENAI_API_KEY below) or "ollama" (free, local, no key).
LLM_PROVIDER=openai

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (only needed when LLM_PROVIDER=ollama). Setup:
#   install from https://ollama.com, then:
#   ollama serve & ollama pull llama3.1 & ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chroma (step 2): run a local persistent server, then point the app at it.
#   pip install chromadb && chroma run --path ./chroma-data
CHROMA_URL=http://localhost:8000
# File-backed dir: memory-backend JSON cache (tests) + default docs path.
CHROMA_DIR=./chroma-data

# SQLite (step 1): file path, created on first run
SQLITE_PATH=./data/adaptquiz.db
